<?xml version="1.0" encoding="utf-8"?>
<!--
  Bike Light icon — 108×108 viewport, safe zone radius 33 (21–87px).
  Elements (back to front):
    1. Light beam cone  — subtle warm triangle toward upper-right
    2. Wheel rim        — white stroke circle, radius 30
    3. Six spokes       — hub r=8 to rim r=27
    4. Hub glow         — amber radial gradient, radius 15
    5. Hub core         — solid white circle, radius 5.5
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Light beam ────────────────────────────────────────────────────── -->
    <!-- Cone from hub (54,54) toward upper-right at 45° ± 20°,
         left edge 65° → (71, 18), right edge 25° → (90, 37). -->
    <path
        android:fillColor="#33FFF5DC"
        android:pathData="M 54,54 L 71,18 L 90,37 Z"/>

    <!-- ── Wheel rim ─────────────────────────────────────────────────────── -->
    <!-- Circle at (54,54), radius 30, drawn as two semicircular arcs. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:pathData="M 24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0"/>

    <!-- ── Six spokes (hub r=8, rim inner r=27) ──────────────────────────── -->
    <path android:strokeColor="#CCCCCC" android:strokeWidth="2"
          android:pathData="M 62,54   L 81,54"/>
    <path android:strokeColor="#CCCCCC" android:strokeWidth="2"
          android:pathData="M 58,60.9 L 67.5,77.4"/>
    <path android:strokeColor="#CCCCCC" android:strokeWidth="2"
          android:pathData="M 50,60.9 L 40.5,77.4"/>
    <path android:strokeColor="#CCCCCC" android:strokeWidth="2"
          android:pathData="M 46,54   L 27,54"/>
    <path android:strokeColor="#CCCCCC" android:strokeWidth="2"
          android:pathData="M 50,47.1 L 40.5,30.6"/>
    <path android:strokeColor="#CCCCCC" android:strokeWidth="2"
          android:pathData="M 58,47.1 L 67.5,30.6"/>

    <!-- ── Hub glow — amber radial gradient ─────────────────────────────── -->
    <path android:pathData="M 39,54 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:gradientRadius="15"
                android:centerX="54"
                android:centerY="54">
                <item android:offset="0.0" android:color="#FFFFCC00"/>
                <item android:offset="0.5" android:color="#AAFFAA00"/>
                <item android:offset="1.0" android:color="#00FFAA00"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ── Hub core — bright white ───────────────────────────────────────── -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 48.5,54 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"/>
</vector>
